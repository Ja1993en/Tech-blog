<section>
  <div class="box-template">
    <div class="header-template">
      <h3>Edit post</h3>
    </div>
    <form class="update-form">
      <label for="fname">Title:</label>
      <input type="text" id="title" name="fname" value="{{posts.title}}"></input>
      <label>comment: </label>
      <textarea id="comment" name="comment" rows="4">{{posts.description}}</textarea>

      <button type="submit" class="form-btn update-post ">Update post</button>
      <button type="button"  class="form-btn delete ">Delete</button>
    </form>
  </div>
  
  <script src="/js/update-post.js"></script>
</section>



  <footer>
    <a href="/dashboard/create-post">+ New Post</a>
  </footer>
